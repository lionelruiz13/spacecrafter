# F94 test B (INTENT 11.214) - does `struct if body_selected equal 503` fire
# for Ganymede, the way doc/superscript.sts:1529 says it does?
# Observable: the clock, read back through the shipped `get status position`
# (field 4 = JDay).  2033-01-01 = the branch fired, 2034-01-01 = the else fired,
# 2030-01-01 = neither (the play never reached the test).
timerate rate 0
date utc 2030-01-01T00:00:00
select planet Ganymede
wait duration 1
struct if body_selected equal 503
date utc 2033-01-01T00:00:00
struct if else
date utc 2034-01-01T00:00:00
struct if end
