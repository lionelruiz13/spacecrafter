#cmake
# Every build tree, by shape rather than by name. Was the literal `build`
# plus three names added one at a time; a fourth (build.stale-cmake322-gcc11,
# 2026-08-23) arrived unnamed and showed up untracked, which is how a derived
# artifact gets swept in by `git add -A` -- the root INTENT 11.137 records.
# No tracked path starts with `build` (verified), and the trailing / keeps it
# to directories.
build*/
src/config.h

