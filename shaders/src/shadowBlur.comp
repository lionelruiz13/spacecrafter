// shadowBlur.comp - the NEW-PATH port of shadow.comp (S5/G7). One change
// class only: the silhouette is read as a SAMPLED_IMAGE through a type-correct
// utexture2D + samplerless texelFetch (the old usampler2DRect-over-D24S8
// access is the Undefined-Value/format-mismatch VUID class - shadow-paths.md
// A2.4/B3). Algorithm, spec constants (0 = radius = the COMPUTE bank variant
// key, 1 = border) and descriptor layout are otherwise identical.
#version 450
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (constant_id=0) const int radius = 64;
layout (constant_id=1) const int border = 256;

layout(binding=0) uniform descriptor {
    float pixelCount; // Number of pixels fetched per output pixel
    int offsets[radius];
};

layout(binding=1) uniform utexture2D bodyShadow;
layout(binding=2, r8) uniform writeonly image2D groundShadow;

// WARNING : Require radius < border/2
void main()
{
    const int baseY = (int(gl_GlobalInvocationID.x) + radius) % border;
    uint sum = 0;
    int i = radius;
    while (i-- > 0)
        sum += uint(texelFetch(bodyShadow, ivec2(i, baseY), 0));

    if (subgroupAll(baseY >= radius && baseY < border - radius)) { // Y-Safe tracing (faster)
        // Initialize sum
        for (i = radius; i > 0; --i) {
            int baseY1 = baseY + i;
            int baseY2 = baseY - i;
            int j = offsets[i];
            while (j-- > 0) {
                sum += uint(texelFetch(bodyShadow, ivec2(j, baseY1), 0));
                sum += uint(texelFetch(bodyShadow, ivec2(j, baseY2), 0));
            }
        }
        // Start early tracing
        for (i = 0; i <= radius; ++i) {
            sum += uint(texelFetch(bodyShadow, ivec2(i+radius, baseY), 0));
            int baseX = i-(radius+1);
            if (baseX >= 0)
                sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY), 0));
            for (int j = radius; j > 0; --j) {
                int baseY1 = baseY+j;
                int baseY2 = baseY-j;
                baseX = i+offsets[j];
                sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
                baseX = i-offsets[j]-1;
                if (baseX >= 0) {
                    sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                    sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
                }
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
        int safeEnd = border - radius;
        // Start tracing
        for (int safeEnd = border - radius; i < safeEnd; ++i) {
            sum += uint(texelFetch(bodyShadow, ivec2(i+radius, baseY), 0));
            sum -= uint(texelFetch(bodyShadow, ivec2(i-(radius+1), baseY), 0));
            for (int j = radius; j > 0; --j) {
                int baseY1 = baseY+j;
                int baseY2 = baseY-j;
                int baseX = i+offsets[j];
                sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
                baseX = i-offsets[j]-1;
                sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
        // Start late tracing
        for (; i < border; ++i) {
            int baseX = i+radius;
            if (baseX < border)
                sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY), 0));
            sum -= uint(texelFetch(bodyShadow, ivec2(i-(radius+1), baseY), 0));
            for (int j = radius; j > 0; --j) {
                int baseY1 = baseY+j;
                int baseY2 = baseY-j;
                baseX = i+offsets[j];
                if (baseX < border) {
                    sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                    sum += uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
                }
                baseX = i-offsets[j]-1;
                sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY1), 0));
                sum -= uint(texelFetch(bodyShadow, ivec2(baseX, baseY2), 0));
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
    } else { // Y-Unsafe tracing (slower)
        int minRelY = (baseY >= radius) ? radius : baseY;
        int maxRelY = (baseY < border - radius) ? radius : (border-1) - baseY;
        // Initialize sum
        for (i = minRelY; i > 0; --i) {
            int baseY1 = baseY-i;
            int j = offsets[i];
            while (j-- > 0)
                sum += uint(texelFetch(bodyShadow, ivec2(j, baseY1), 0));
        }
        for (i = maxRelY; i > 0; --i) {
            int baseY2 = baseY+i;
            int j = offsets[i];
            while (j-- > 0)
                sum += uint(texelFetch(bodyShadow, ivec2(j, baseY2), 0));
        }
        // Start early tracing
        for (i = 0; i <= radius; ++i) {
            ivec2 coord = ivec2(i+radius, baseY);
            sum += uint(texelFetch(bodyShadow, coord, 0));
            if ((coord.x = i-(radius+1)) >= 0)
                sum -= uint(texelFetch(bodyShadow, coord, 0));
            for (int j = minRelY; j > 0; --j) {
                coord = ivec2(i+offsets[j], baseY-j);
                sum += uint(texelFetch(bodyShadow, coord, 0));
                if ((coord.x = i-offsets[j]-1) >= 0)
                    sum -= uint(texelFetch(bodyShadow, coord, 0));
            }
            for (int j = maxRelY; j > 0; --j) {
                coord = ivec2(i+offsets[j], baseY+j);
                sum += uint(texelFetch(bodyShadow, coord, 0));
                if ((coord.x = i-offsets[j]-1) >= 0)
                    sum -= uint(texelFetch(bodyShadow, coord, 0));
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
        // Start tracing
        for (int safeEnd = border - radius; i < safeEnd; ++i) {
            ivec2 coord = ivec2(i+radius, baseY);
            sum += uint(texelFetch(bodyShadow, coord, 0));
            coord.x = i-(radius+1);
            sum -= uint(texelFetch(bodyShadow, coord, 0));
            for (int j = minRelY; j > 0; --j) {
                coord = ivec2(i+offsets[j], baseY-j);
                sum += uint(texelFetch(bodyShadow, coord, 0));
                coord.x = i-offsets[j]-1;
                sum -= uint(texelFetch(bodyShadow, coord, 0));
            }
            for (int j = maxRelY; j > 0; --j) {
                coord = ivec2(i+offsets[j], baseY+j);
                sum += uint(texelFetch(bodyShadow, coord, 0));
                coord.x = i-offsets[j]-1;
                sum -= uint(texelFetch(bodyShadow, coord, 0));
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
        // Start late tracing
        for (; i < border; ++i) {
            ivec2 coord = ivec2(i-(radius+1), baseY);
            sum -= uint(texelFetch(bodyShadow, coord, 0));
            if ((coord.x = i+radius) < border)
                sum += uint(texelFetch(bodyShadow, coord, 0));
            for (int j = minRelY; j > 0; --j) {
                coord = ivec2(i-offsets[j]-1, baseY-j);
                sum -= uint(texelFetch(bodyShadow, coord, 0));
                if ((coord.x = i+offsets[j]) < border)
                    sum += uint(texelFetch(bodyShadow, coord, 0));
            }
            for (int j = maxRelY; j > 0; --j) {
                coord = ivec2(i-offsets[j]-1, baseY+j);
                sum -= uint(texelFetch(bodyShadow, coord, 0));
                if ((coord.x = i+offsets[j]) < border)
                    sum += uint(texelFetch(bodyShadow, coord, 0));
            }
            imageStore(groundShadow, ivec2(i, baseY), vec4(float(sum) / pixelCount, 0, 0, 0));
        }
    }
}
