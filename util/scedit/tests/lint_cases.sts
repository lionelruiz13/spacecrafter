# scedit --check fixture: one construct per armed lint id.
# NOT a runnable script - every non-comment line here is deliberately wrong in
# exactly one way (except where the comment says otherwise), so the expected
# output in tests/lint-expected.txt is a per-rule proof that the rule fires,
# with the right id, severity and D6 shape.

# --- unknown-command: not in m_commands, engine logs a nearest neighbour
zomo action now

# --- deprecated: an obsolete token used as a command name
movetocity name Paris country France

# --- orphaned-flag: spelled in the engine header, never registered
flag sky_draw on

# --- deprecated: an obsolete token used as a flag name
flag point_star on

# --- unknown-parameter: a flag name that is in no family
flag starz on

# --- silent-off-value: not an on-form, off-form or 'toggle' -> silently OFF
flag stars yes

# --- silent-off-value again: W_TOGGLE is compared case-SENSITIVELY
flag stars TOGGLE

# --- single-pair-only: only the alphabetically first pair is applied
flag stars on atmosphere on

# --- dangling-key: odd token count, the trailing key is dropped
body name x action

# --- duplicate-key: std::map keeps the last value
body halo true halo false

# --- unsupported-quoting: single quotes do not group
text string 'hello world' x

# --- unsupported-quoting: there is no backslash escape
text string "a\"b"

# --- alias-respelled: recording writes this back as 'camera'
flyto action move_to

# --- inert-command: parses, reports success, does nothing
set mode InGalaxy

# --- unknown-parameter: a set name that is in no family
set stall_radius_unitt 5

# --- unknown-parameter: for 'color' the family name is the VALUE of 'property'
color property constellation_liness value 1,0,0

# --- indented comment: reaches the parser as an unknown command
  # this line is executed, not skipped


# --- unknown-parameter, ARGUMENT-KEY half: a key this command never reads.
# Armed by the merged `args` data alone; the two rotations do nothing.
dso3d action load zrot 0

# --- unknown-parameter, argument-key half, with a suggestion inside the cap
landscape action load nmae panorama

# --- unknown-command / unknown-parameter: NO suggestion past the cap.
# The engine would log 'nebula_names' here; that is a false lead, so it is not
# printed (the finding itself is unchanged). doc/superscript.sts:303 is this line.
flag date_display_number on

# --- alias-respelled only: `flyto` IS `camera`, so camera's args_complete:false
# covers it too and none of the anchor keys below is reported.
flyto action create name observatory type point x 1 y 2 z 3

# --- invisible-separator: a no-break space where a space belongs.
# The engine reads 'hello<0xA0>world' as ONE word, so `string` swallows both.
text name info string hello world altitude 10

# --- invisible-separator + its consequence, both reported (cause first).
# This is doc/superscript.sts:94's shape: the byte glues '2' to 'size', which
# shifts every later pair by one and leaves '3' as a key with no value.
dso2d action load name x ra 1 de 2 size 3

# --- end-without-if / else-without-if: closers with no open block. The engine
# logs "end without if" / "else without if" and ignores the line.
struct if end
struct if else

# --- loop-end-without-loop: silent engine-side; nothing repeats
struct loop end

# --- inline-comment: a '#' after the command is not a comment; the tail is
# read as key/value pairs. Here none of them is a key `media` reads, so the
# line happens to work (the witness's shape, doc/superscript.sts:37-46).
media action pause # stop video & sound

# --- inline-comment, the pair-killing shape: `flag` applies the alphabetically
# first pair, which is now '#' - `stars on` is never applied
flag stars on # switch it on

# --- inline-comment, the line-killing shape: `set` stops at the first unknown
# name, which is now '#' - nothing on the line is applied
set star_scale 2 # bigger stars

# --- inline-comment, the colliding shape: a comment word that lands in KEY
# position and IS a key ('#'='set', then 'loop'='on' - the engine keeps it)
media action pause # set loop on

# --- inline-comment, nothing after the '#': a trailing key, dropped
media action pause #

# === everything below must produce NO finding (until the last section) ==

# a well-formed line of each shape the rules touch
flag stars on
flag stars toggle
flag stars off
set home_planet Mars
color property constellation_lines r 1 g 0 b 0
font target planets filename Gloria.ttf size 14
body name "ALSAT 1" parent Earth radius 1
text name info string "It's your home" altitude 10 align center
struct if a equal b
struct if end
struct loop 2
struct loop end
camera action move_to

# a commented-out block: the engine never runs these, so neither do we
comment
zomo action now
flag sky_draw on
  # indented inside a comment block
uncomment

# the same block through the 'struct comment' spelling, entered twice
struct comment on
zomo action now
struct comment off
struct comment TRUE
zomo action now
struct comment off

# a command whose entry says args_complete:false is silent on its keys: the
# rest of `body`'s vocabulary is the stellar-system contract's to state, so an
# unlisted key here is not known to be wrong (and `radius` above is the same case)
body action load parent Sun
camera action create name observatory type point x 1 y 2 z 3

# a no-break space INSIDE a quoted value is ordinary text: the engine already
# accepts spaces there, so the author meant the byte and nothing surprises them
text name info string "hello world" altitude 10

# === unclosed at end of file: reported at the OPENER line ==============
# The checker only knows at the end of the file; the finding lands here.
struct if a equal b
struct loop 3
