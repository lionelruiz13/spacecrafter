# Model-generalization scenes (INTENT 11.15 follow-up): surface baseline,
# high-altitude (50 km), and satellite-reference (observer on the Moon).
# Requires init_fov = 340 in config.ini (zoom fov does not reach the new
# camera - INTENT 11.15c). Analyze each dump with harness/predict.py.
date jday 2461233.5
timerate rate 0

# Scene A - Earth surface, Paris 100 m (regression baseline)
moveto lat 48.85 lon 2.35 alt 100 duration 0
select planet Moon
flag track_object on
wait duration 3
body action dual_dump filename /tmp/gen_a.json

# Scene B - Earth, 50 km altitude (non-surface, same placement conventions)
moveto lat 48.85 lon 2.35 alt 50000 duration 0
wait duration 3
body action dual_dump filename /tmp/gen_b.json

# Scene C - observer on the Moon (satellite reference: exercises the seam
# propagation, warp re-referencing, deeper walk-up chain, and the
# accumulated-vs-single body orientation question for the observer frame)
set home_planet Moon
moveto lat 10 lon 30 alt 100 duration 0
select planet Earth
flag track_object on
wait duration 3
body action dual_dump filename /tmp/gen_moon.json

shutdown action now
