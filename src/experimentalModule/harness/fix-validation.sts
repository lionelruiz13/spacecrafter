# Triplet fix-validation run (harness/predict.py) - derived from dual-dump.sts.
# Wide init_fov (340, set in config.ini for this run) keeps Sun/Moon/Mars
# inside the visibility cone -> fresh full matrices in the new path.
date jday 2461233.5
timerate rate 0
moveto lat 48.85 lon 2.35 alt 100 duration 0
select planet Moon
flag track_object on
wait duration 3
body action dual_dump filename /tmp/fix_trace.json
timerate rate 1
date jday 2461321.25
timerate rate 0
wait duration 3
body action dual_dump filename /tmp/fix_trace_2.json
shutdown action now
